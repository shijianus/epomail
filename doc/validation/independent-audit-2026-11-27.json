    },
    {
      "priority": "P2",
      "file": "mail-worker/src/service/email-service.js:1407",
      "finding": "Resend send call provides no AbortSignal; SDK 6.4.1 also calls fetch without adding a timeout. Stubbed provider probe observed signalPresent=false. Leases/UNKNOWN reconciliation limit duplicate sending but do not provide an outbound request deadline."
    },
    {
      "priority": "P2",
      "file": "mail-worker/pnpm-lock.yaml:45",
