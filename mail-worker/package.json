{
	"name": "mail-worker",
	"version": "1.2.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "wrangler dev --config wrangler-dev.toml",
		"test": "vitest run",
		"test:unit": "vitest run test/security-hardening.spec.js test/totp-backend-fixes.spec.js",
		"test:integration": "vitest run test/index.spec.js test/object-ownership.spec.js test/oauth-security.spec.js test/security-delivery.spec.js test/security-round2.spec.js",
		"test:mailjet": "node test-mailjet.js",
		"deploy": "wrangler deploy",
		"deploy:test": "wrangler deploy --config wrangler-test.toml",
		"start": "wrangler dev"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.7.5",
		"vitest": "~3.0.7",
		"wrangler": "^4.90.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1156.0",
		"@noble/hashes": "1.8.0",
		"dayjs": "^1.11.13",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.13",
		"i18next": "^25.3.2",
		"linkedom": "^0.18.10",
		"postal-mime": "^2.4.3",
		"resend": "^6.4.1",
		"ua-parser-js": "^2.0.10",
		"uuid": "^11.1.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"workerd",
			"esbuild",
			"sharp"
		],
		"overrides": {
			"fast-xml-parser": "^5.11.2",
			"form-data": "^4.0.6",
			"uuid": "^11.1.1"
		}
	}
}
